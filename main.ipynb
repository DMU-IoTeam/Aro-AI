    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "npy_path = \"reduced_extracted_data/npy/train/fall/00004_H_A_SY_C4.npy\"\n",
    "data = np.load(npy_path)\n",
    "num_joints = 13\n",
    "\n",
    "# ❗ 유효한 프레임 찾기\n",
    "for i in range(len(data)):\n",
    "    frame = data[i]\n",
    "    coords = frame[:num_joints * 4].reshape(num_joints, 4)\n",
    "    xys = coords[:, :2]\n",
    "    if not np.allclose(xys, 0):\n",
    "        print(f\"✅ 유효한 프레임 인덱스: {i}\")\n",
    "        break\n",
    "\n",
    "# ✅ 시각화용 스케일\n",
    "scale = 1000\n",
    "xys *= scale\n",
    "\n",
    "# 🔹 연결 관계 정의\n",
    "connections = [\n",
    "    (0, 1), (1, 2), (2, 3),\n",
    "    (1, 4), (4, 5), (5, 6),\n",
    "    (2, 7), (7, 8), (8, 9),\n",
    "    (3, 10), (10, 11), (11, 12)\n",
    "]\n",
    "\n",
    "# 🔹 시각화\n",
    "plt.figure(figsize=(5, 5))\n",
    "plt.scatter(xys[:, 0], -xys[:, 1], c='red')\n",
    "for start, end in connections:\n",
    "    x0, y0 = xys[start]\n",
    "    x1, y1 = xys[end]\n",
    "    plt.plot([x0, x1], [-y0, -y1], c='blue')\n",
    "for i, (x, y) in enumerate(xys):\n",
    "    plt.text(x, -y, str(i), fontsize=8)\n",
    "plt.title(\"Skeleton (Scaled and Valid Frame)\")\n",
    "plt.axis('equal')\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
